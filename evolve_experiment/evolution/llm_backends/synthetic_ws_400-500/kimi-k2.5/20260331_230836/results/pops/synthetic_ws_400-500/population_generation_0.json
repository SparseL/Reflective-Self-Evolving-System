          "algorithm": "",
          "code": "def select_next_node(graph, unvisited_nodes):\n    precomputed = graph.graph.get('precomputed', {})\n    bridge_ratio = precomputed.get('bridge_ratio_high_bc', 0.0)\n    max_core = precomputed.get('max_core_k', 1)\n    avg_deg = precomputed.get('avg_degree', 1.0)\n    \n    max_core = max(max_core, 1)\n    avg_deg = max(avg_deg, 0.1)\n    \n    best_node = None\n    best_score = -float('inf')\n    \n    alpha = 0.6 + bridge_ratio\n    beta = 1.0 - bridge_ratio * 0.3\n    \n    for node in unvisited_nodes:\n        nd = graph.nodes[node]\n        degree = nd.get('degree', 0)\n        core = nd.get('core_number', 0)\n        eig = nd.get('eigenvector', 0.0)\n        btw = nd.get('betweenness', 0.0)\n        clust = nd.get('clustering', 0.0)\n        \n        norm_core = core / max_core\n        norm_deg = degree / avg_deg\n        \n        if degree > 0:\n            bridge_efficiency = btw / (degree ** 0.5)\n        else:\n            bridge_efficiency = 0.0\n        \n        influence = norm_core * eig\n        redundancy_penalty = 1.0 / (1.0 + beta * clust)\n        \n        score = influence * (1.0 + alpha * bridge_efficiency) * redundancy_penalty * norm_deg\n        \n        if score > best_score:\n            best_score = score\n            best_node = node\n            \n    return best_node",
