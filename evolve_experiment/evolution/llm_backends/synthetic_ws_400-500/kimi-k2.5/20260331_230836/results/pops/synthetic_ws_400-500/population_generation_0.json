[
     {
          "algorithm": "This algorithm iteratively selects the unvisited node maximizing a structural fragility score defined as the product of normalized k-core number, the local bridging coefficient (degree divided by clustering), eigenvector centrality, and an adaptive term that scales betweenness by the graph's bridge ratio, thereby targeting high-influence articulation points within the core structure to balance rapid initial fragmentation with thorough long-term collapse.",
          "code": "def select_next_node(graph, unvisited_nodes):\n    # Extract precomputed graph-level features once for efficiency\n    precomputed = graph.graph['precomputed']\n    max_core = precomputed['max_core_k']\n    avg_degree = precomputed['avg_degree']\n    bridge_ratio = precomputed['bridge_ratio_high_bc']\n    epsilon = 1e-9\n    \n    best_node = None\n    best_score = -float('inf')\n    \n    for node in unvisited_nodes:\n        # Access precomputed node features in O(1)\n        core = graph.nodes[node]['core_number']\n        clustering = graph.nodes[node]['clustering']\n        degree = graph.nodes[node]['degree']\n        betweenness = graph.nodes[node]['betweenness']\n        eigenvector = graph.nodes[node]['eigenvector']\n        \n        # Calculate components of the fragility score\n        norm_core = core / (max_core + epsilon)\n        local_bridge = degree / (clustering + epsilon)  # High degree, low clustering = bridge\n        influence = 1.0 + eigenvector\n        \n        # Adaptive weighting: amplify betweenness importance if graph has many bridges\n        adaptive_bridge = 1.0 + bridge_ratio * betweenness\n        \n        # Composite score: prioritizes core nodes that are local bridges with high influence\n        score = norm_core * local_bridge * influence * adaptive_bridge\n        \n        if score > best_score:\n            best_score = score\n            best_node = node\n            \n    return best_node",
