          "code": "def select_next_node(graph, unvisited_nodes):\n    precomp = graph.graph.get('precomputed', {})\n    max_core = precomp.get('max_core_k', 1)\n    bridge_ratio = precomp.get('bridge_ratio_high_bc', 0.5)\n    epsilon = 1e-9\n    \n    best_node = unvisited_nodes[0]\n    best_score = -float('inf')\n    \n    for node in unvisited_nodes:\n        nd = graph.nodes[node]\n        betweenness = nd.get('betweenness', 0)\n        core_num = nd.get('core_number', 0)\n        eigen = nd.get('eigenvector', 0)\n        clustering = nd.get('clustering', 0)\n        \n        # Avoid division by zero and handle edge cases\n        norm_core = core_num / max_core if max_core > 0 else 0\n        \n        # Structural Fragility Index: combines global bridge, structural integrity,\n        # and influence, penalized by local density\n        score = ((betweenness ** (1 + bridge_ratio)) * \n                 (1 + norm_core) * \n                 (1 + eigen) / \n                 (clustering + epsilon))\n        \n        if score > best_score:\n            best_score = score\n            best_node = node\n            \n    return best_node",
