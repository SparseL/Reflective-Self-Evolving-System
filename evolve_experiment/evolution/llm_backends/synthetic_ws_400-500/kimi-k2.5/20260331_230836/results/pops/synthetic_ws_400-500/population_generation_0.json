          "code": "def select_next_node(graph, unvisited_nodes):\n    precomputed = graph.graph.get('precomputed', {})\n    avg_degree = precomputed.get('avg_degree', 1.0)\n    max_core_k = precomputed.get('max_core_k', 1)\n    \n    inv_avg_deg = 1.0 / avg_degree if avg_degree > 0 else 1.0\n    best_score = -1.0\n    next_node = unvisited_nodes[0]\n    \n    for node in unvisited_nodes:\n        nd = graph.nodes[node]\n        betweenness = nd.get('betweenness', 0.0)\n        core_num = nd.get('core_number', 0)\n        degree = nd.get('degree', 0)\n        clustering = nd.get('clustering', 0.0)\n        \n        core_gap = max_core_k - core_num + 1\n        norm_degree = degree * inv_avg_deg\n        clustering_adj = clustering if clustering > 0 else 0.0001\n        \n        score = betweenness * core_gap * norm_degree / clustering_adj\n        \n        if score > best_score:\n            best_score = score\n            next_node = node\n            \n    return next_node",
