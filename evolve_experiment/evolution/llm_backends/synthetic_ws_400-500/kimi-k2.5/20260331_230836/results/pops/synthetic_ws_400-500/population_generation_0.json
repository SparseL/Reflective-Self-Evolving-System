          "code": "def select_next_node(graph, unvisited_nodes):\n    max_core_k = graph.graph['precomputed']['max_core_k']\n    best_node = unvisited_nodes[0]\n    best_score = -1.0\n    \n    for node in unvisited_nodes:\n        core = graph.nodes[node]['core_number']\n        betweenness = graph.nodes[node]['betweenness']\n        eigenvector = graph.nodes[node]['eigenvector']\n        clustering = graph.nodes[node]['clustering']\n        \n        score = (core / max_core_k) * betweenness * eigenvector / (1.0 + clustering)\n        \n        if score > best_score:\n            best_score = score\n            best_node = node\n            \n    return best_node",
