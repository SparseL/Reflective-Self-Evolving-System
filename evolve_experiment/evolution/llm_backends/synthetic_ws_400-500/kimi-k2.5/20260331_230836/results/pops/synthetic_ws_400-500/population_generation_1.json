          "algorithm": "",
          "code": "def select_next_node(graph, unvisited_nodes):\n    precomp = graph.graph.get('precomputed', {})\n    max_core = precomp.get('max_core_k', 1)\n    avg_deg = precomp.get('avg_degree', 1.0)\n    deg_var = precomp.get('degree_variance', 0.0)\n    epsilon = 1e-9\n    \n    # Calculate coefficient of variation squared to measure network heterogeneity\n    cv_sq = (deg_var / (avg_deg ** 2)) if avg_deg > 0 else 0.0\n    \n    best_node = unvisited_nodes[0]\n    best_score = -float('inf')\n    \n    for node in unvisited_nodes:\n        nd = graph.nodes[node]\n        core = nd.get('core_number', 0)\n        btw = nd.get('betweenness', 0.0)\n        eigen = nd.get('eigenvector', 0.0)\n        clust = nd.get('clustering', 0.0)\n        \n        norm_core = core / max_core if max_core > 0 else 0.0\n        \n        # Geometric mean of local (core) and global (betweenness) centrality\n        # Penalizes nodes strong in only one dimension; rewards balanced high performers\n        geo_balance = (norm_core * btw) ** 0.5\n        \n        # Adaptive eigenvector weighting: high heterogeneity amplifies influence importance\n        adaptive_influence = eigen * (1.0 + cv_sq)\n        \n        # Final score penalizes redundant clustered nodes\n        score = (geo_balance * adaptive_influence) / (clust + epsilon)\n        \n        if score > best_score:\n            best_score = score\n            best_node = node\n            \n    return best_node",
