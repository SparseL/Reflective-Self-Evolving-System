[
     {
          "algorithm": "The algorithm selects nodes by maximizing a harmonic mean between normalized core centrality and square-root-dampened betweenness centrality, where the relative weights are adaptively set by the coefficient of variation and bridge ratio to shift priority between local core integrity and global bridge disruption, further modulated by spectral influence and penalized by local clustering to avoid redundant removals.",
          "code": "def select_next_node(graph, unvisited_nodes):\n    precomp = graph.graph['precomputed']\n    max_core = precomp['max_core_k']\n    avg_degree = precomp['avg_degree']\n    deg_var = precomp['degree_variance']\n    bridge_ratio = precomp['bridge_ratio_high_bc']\n    \n    cv = (deg_var ** 0.5) / avg_degree if avg_degree > 0 else 0.0\n    \n    w_btw = (1.0 + cv) * (1.0 + bridge_ratio)\n    w_core = 1.0 / (1.0 + cv)\n    \n    epsilon = 1e-9\n    best_score = -1.0\n    next_node = unvisited_nodes[0]\n    \n    for node in unvisited_nodes:\n        nd = graph.nodes[node]\n        core = nd['core_number']\n        btw = nd['betweenness']\n        eigen = nd['eigenvector']\n        clust = nd['clustering']\n        \n        norm_core = core / max_core if max_core > 0 else 0.0\n        damp_btw = btw ** 0.5\n        \n        val_core = w_core * norm_core\n        val_btw = w_btw * damp_btw\n        \n        if val_core + val_btw < epsilon:\n            harmonic = 0.0\n        else:\n            harmonic = (2.0 * val_core * val_btw) / (val_core + val_btw)\n        \n        score = harmonic * (1.0 + eigen) / (clust + epsilon)\n        \n        if score > best_score:\n            best_score = score\n            next_node = node\n            \n    return next_node",
