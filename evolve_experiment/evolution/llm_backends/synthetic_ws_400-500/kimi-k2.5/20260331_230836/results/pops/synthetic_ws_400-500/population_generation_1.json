          "algorithm": "",
          "code": "def select_next_node(graph, unvisited_nodes):\n    precomp = graph.graph.get('precomputed', {})\n    max_core = precomp.get('max_core_k', 1)\n    avg_deg = precomp.get('avg_degree', 1.0)\n    deg_var = precomp.get('degree_variance', 0.0)\n    \n    # Calculate coefficient of variation to measure network heterogeneity\n    cv = (deg_var ** 0.5) / avg_deg if avg_deg > 0 else 0\n    \n    # Dynamic weighting: high heterogeneity networks prioritize global bridges (betweenness)\n    # while homogeneous networks prioritize local structural integrity (core + eigenvector)\n    w_local = 1.0 / (1.0 + cv)   # Decreases as heterogeneity increases\n    w_global = 1.0 + cv          # Increases as heterogeneity increases\n    \n    epsilon = 1e-9\n    best_node = unvisited_nodes[0]\n    best_score = -float('inf')\n    \n    for node in unvisited_nodes:\n        nd = graph.nodes[node]\n        core = nd.get('core_number', 0)\n        eigen = nd.get('eigenvector', 0.0)\n        btw = nd.get('betweenness', 0.0)\n        clust = nd.get('clustering', 0.0)\n        \n        norm_core = core / max_core if max_core > 0 else 0\n        \n        # Local component: core position and spectral importance\n        local_score = norm_core + eigen\n        \n        # Global component: dampened betweenness (square root reduces extreme values)\n        global_score = btw ** 0.5\n        \n        # Adaptive aggregation with clustering penalty (redundancy avoidance)\n        score = (w_local * local_score + w_global * global_score) / (clust + epsilon)\n        \n        if score > best_score:\n            best_score = score\n            best_node = node\n            \n    return best_node",
