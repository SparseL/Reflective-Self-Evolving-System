     {
          "algorithm": "A hybrid heuristic that adjusts node selection weights based on graph bridge ratio, combining betweenness centrality, core number, and inverted clustering coefficient with dynamic weighting.",
          "code": "def select_next_node(graph, unvisited_nodes):\n    precomputed = graph.graph['precomputed']\n    br = precomputed['bridge_ratio_high_bc']\n    w1 = 0.5 + 0.5 * br  \n    w2 = 0.5\n    w3 = 0.5 - 0.3 * br  \n    max_core = precomputed['max_core_k'] if precomputed['max_core_k'] > 0 else 1\n\n    best_node = None\n    best_score = -float('inf')\n    for node in unvisited_nodes:\n        b = graph.nodes[node]['betweenness']\n        core_norm = graph.nodes[node]['core_number'] / max_core\n        clust_inv = 1 - graph.nodes[node]['clustering']\n        score = w1 * b + w2 * core_norm + w3 * clust_inv\n        if score > best_score:\n            best_score = score\n            best_node = node\n    return best_node",
