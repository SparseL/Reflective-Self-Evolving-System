     {
          "algorithm": "Proposing a \"Local Bridge-Core Impact\" (LBCI) algorithm that prioritizes nodes with high coreness and high local bridge potential via normalized edge betweenness.",
          "code": "def select_next_node(graph, unvisited_nodes):\n    max_score = -float('inf')\n    selected_node = None\n    \n    for node in unvisited_nodes:\n        core = graph.nodes[node]['core_number']\n        eb_sum = 0.0\n        neighbors = list(graph.neighbors(node))\n        if not neighbors:\n            continue\n        for neighbor in neighbors:\n            edge_data = graph.get_edge_data(node, neighbor)\n            if 'normalized_eb' in edge_data:\n                eb_sum += edge_data['normalized_eb']\n        score = core * (eb_sum / len(neighbors))\n        \n        if score > max_score:\n            max_score = score\n            selected_node = node\n    \n    if selected_node is None:\n        selected_node = unvisited_nodes[0] if unvisited_nodes else None\n        \n    return selected_node",
