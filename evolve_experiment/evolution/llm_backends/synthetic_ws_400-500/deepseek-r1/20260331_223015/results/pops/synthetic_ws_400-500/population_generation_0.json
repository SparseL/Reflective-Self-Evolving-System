     {
          "algorithm": "We design a novel adaptive centrality algorithm that dynamically weights degree, core number, and betweenness centrality based on the graph's bridge ratio and maximum core number to balance immediate impact and long-term fragmentation.",
          "code": "def select_next_node(graph, unvisited_nodes):\n    precomputed = graph.graph['precomputed']\n    if 'global_max_degree' not in precomputed:\n        precomputed['global_max_degree'] = max(graph.degree[node] for node in graph.nodes)\n        precomputed['global_max_core'] = max(graph.nodes[node]['core_number'] for node in graph.nodes)\n        precomputed['global_max_betweenness'] = max(graph.nodes[node]['betweenness'] for node in graph.nodes)\n    \n    br = precomputed['bridge_ratio_high_bc']\n    max_core = precomputed['max_core_k']\n    \n    w1 = 0.3\n    w2 = 0.3 + 0.4 * min(max_core / 100, 1)\n    w3 = 0.4 + 0.3 * min(br, 1)\n    total = w1 + w2 + w3\n    w1, w2, w3 = w1/total, w2/total, w3/total\n\n    max_deg = precomputed['global_max_degree'] or 1\n    max_core_val = precomputed['global_max_core'] or 1\n    max_bet = precomputed['global_max_betweenness'] or 1\n    \n    best_node = None\n    best_score = -1\n    for node in unvisited_nodes:\n        deg_norm = graph.degree[node] / max_deg\n        core_norm = graph.nodes[node]['core_number'] / max_core_val\n        bet_norm = graph.nodes[node]['betweenness'] / max_bet\n        score = w1 * deg_norm + w2 * core_norm + w3 * bet_norm\n        if score > best_score:\n            best_score = score\n            best_node = node\n            \n    return best_node",
