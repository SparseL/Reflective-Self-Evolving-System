     {
          "algorithm": "\"Dynamic Weighted Feature Scoring (DWFS) algorithm: Adaptively weights betweenness centrality and k-core centrality based on graph-level bridge ratio and relative core density to balance immediate disruption and structural impact.\"",
          "code": "import networkx as nx\n\ndef select_next_node(graph, unvisited_nodes):\n    if not unvisited_nodes:\n        return None\n    \n    max_core = max(graph.nodes[u]['core_number'] for u in unvisited_nodes)\n    max_bc = max(graph.nodes[u]['betweenness'] for u in unvisited_nodes) if any(graph.nodes[u]['betweenness'] > 0 for u in unvisited_nodes) else 1\n    \n    total_core = sum(graph.nodes[u]['core_number'] for u in unvisited_nodes)\n    avg_core_unvisited = total_core / len(unvisited_nodes)\n    \n    precomputed = graph.graph['precomputed']\n    w_bridge = precomputed['bridge_ratio_high_bc']\n    w_core = (avg_core_unvisited / precomputed['max_core_k']) ** 0.5\n    \n    best_node = None\n    best_score = -float('inf')\n    \n    for node in unvisited_nodes:\n        norm_core = graph.nodes[node]['core_number'] / max_core\n        norm_bc = graph.nodes[node]['betweenness'] / max_bc\n        \n        score = w_bridge * norm_bc + w_core * norm_core\n        if score > best_score:\n            best_score = score\n            best_node = node\n            \n    return best_node",
