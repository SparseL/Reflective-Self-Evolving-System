     {
          "algorithm": "Our algorithm is a hybrid adaptive strategy that combines core number, betweenness centrality, and eigenvector centrality with a multiplicative penalty based on local clustering coefficient to prioritize nodes that are globally central and locally critical, while dynamically adjusting weights based on disintegration progress to shift from aggressive to thorough fragmentation.",
          "code": "def select_next_node(graph, unvisited_nodes):\n    import sys\n    \n    total_nodes = graph.graph['precomputed']['total_nodes']\n    remaining = len(unvisited_nodes)\n    fraction_removed = (total_nodes - remaining) / total_nodes\n    alpha = max(0.5, 1 - fraction_removed)\n    \n    min_b, max_b = sys.float_info.max, 0\n    min_core, max_core = sys.maxsize, 0\n    min_eigen, max_eigen = sys.float_info.max, 0\n    \n    for node in unvisited_nodes:\n        betweenness = graph.nodes[node]['betweenness']\n        core_num = graph.nodes[node]['core_number']\n        eigen = graph.nodes[node]['eigenvector']\n        \n        if betweenness < min_b: min_b = betweenness\n        if betweenness > max_b: max_b = betweenness\n        if core_num < min_core: min_core = core_num\n        if core_num > max_core: max_core = core_num\n        if eigen < min_eigen: min_eigen = eigen\n        if eigen > max_eigen: max_eigen = eigen\n    \n    range_b = max_b - min_b if max_b != min_b else 1\n    range_core = max_core - min_core if max_core != min_core else 1\n    range_eigen = max_eigen - min_eigen if max_eigen != min_eigen else 1\n    \n    best_score = -sys.float_info.max\n    best_node = None\n    \n    for node in unvisited_nodes:\n        b_norm = (graph.nodes[node]['betweenness'] - min_b) / range_b\n        core_norm = (graph.nodes[node]['core_number'] - min_core) / range_core\n        eigen_norm = (graph.nodes[node]['eigenvector'] - min_eigen) / range_eigen\n        \n        clustering_factor = 1 - graph.nodes[node]['clustering']\n        combined = alpha * b_norm + (1 - alpha) * core_norm + eigen_norm\n        score = combined * clustering_factor\n        \n        if score > best_score:\n            best_score = score\n            best_node = node\n            \n    return best_node",
