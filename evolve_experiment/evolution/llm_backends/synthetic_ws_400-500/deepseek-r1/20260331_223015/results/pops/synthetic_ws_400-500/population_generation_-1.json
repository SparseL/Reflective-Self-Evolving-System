     {
          "algorithm": "A dynamic weighted feature combination algorithm that shifts focus from betweenness to core number as the removal progresses, with minor contributions from degree and eigenvector centrality.",
          "code": "import networkx as nx\n\ndef select_next_node(graph, unvisited_nodes):\n    n_total = graph.number_of_nodes()\n    progress = 1 - (len(unvisited_nodes) / n_total)\n    \n    max_deg = max(graph.nodes[u]['degree'] for u in unvisited_nodes) if unvisited_nodes else 0\n    max_core = max(graph.nodes[u]['core_number'] for u in unvisited_nodes) if unvisited_nodes else 0\n    max_betw = max(graph.nodes[u]['betweenness'] for u in unvisited_nodes) if unvisited_nodes else 0\n    max_eigen = max(graph.nodes[u]['eigenvector'] for u in unvisited_nodes) if unvisited_nodes else 0\n    \n    best_node = None\n    best_score = float('-inf')\n    \n    for u in unvisited_nodes:\n        norm_deg = graph.nodes[u]['degree'] / max_deg if max_deg > 0 else 0\n        norm_core = graph.nodes[u]['core_number'] / max_core if max_core > 0 else 0\n        norm_betw = graph.nodes[u]['betweenness'] / max_betw if max_betw > 0 else 0\n        norm_eigen = graph.nodes[u]['eigenvector'] / max_eigen if max_eigen > 0 else 0\n        \n        score = (1 - progress) * norm_betw + progress * norm_core + 0.2 * norm_deg + 0.2 * norm_eigen\n        \n        if score > best_score:\n            best_score = score\n            best_node = u\n            \n    return best_node",
