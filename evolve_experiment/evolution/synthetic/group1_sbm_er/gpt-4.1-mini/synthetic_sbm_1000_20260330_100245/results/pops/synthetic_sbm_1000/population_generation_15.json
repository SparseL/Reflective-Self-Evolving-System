          "algorithm": "",
          "code": "def select_next_node(graph, unvisited_nodes):\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.5)\n    degree_variance = pre.get('degree_variance', 1.0)\n\n    # Pre-extract features\n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    betweennesses = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    clusterings = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    eigenvectors = [graph.nodes[n]['eigenvector'] for n in unvisited_nodes]\n\n    def min_max_norm(arr):\n        mn, mx = min(arr), max(arr)\n        if mx - mn < 1e-9:\n            return [0.0] * len(arr)\n        return [(x - mn) / (mx - mn) for x in arr]\n\n    deg_norm = min_max_norm(degrees)\n    betw_norm = min_max_norm(betweennesses)\n    clust_norm = min_max_norm(clusterings)\n    eig_norm = min_max_norm(eigenvectors)\n\n    # Dynamic weights to balance metrics based on graph properties\n    w_betw = 0.5 * (1 - bridge_ratio) + 0.3 * degree_variance\n    w_eig = 0.4 * bridge_ratio + 0.3 * (1 - degree_variance)\n    w_clust = 1.0 - (w_betw + w_eig)\n    if w_clust < 0:\n        w_clust = 0\n        total = w_betw + w_eig\n        w_betw /= total\n        w_eig /= total\n\n    best_score = -float('inf')\n    next_node = None\n\n    for i, n in enumerate(unvisited_nodes):\n        score = w_betw * betw_norm[i] + w_eig * eig_norm[i] + w_clust * (1 - clust_norm[i])\n        if score > best_score:\n            best_score = score\n            next_node = n\n\n    return next_node",
