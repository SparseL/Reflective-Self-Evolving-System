          "code": "def select_next_node(graph, unvisited_nodes):\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.5)\n    degree_variance = pre.get('degree_variance', 1.0)\n    max_core_k = pre.get('max_core_k', 1)\n\n    core_nums = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n    clusterings = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    betweennesses = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n\n    def min_max_norm(arr):\n        mn, mx = min(arr), max(arr)\n        if mx - mn < 1e-9:\n            return [0.0] * len(arr)\n        return [(x - mn) / (mx - mn) for x in arr]\n\n    core_norm = min_max_norm(core_nums)\n    clust_inv_norm = min_max_norm([1 - c for c in clusterings])\n    betw_norm = min_max_norm(betweennesses)\n\n    # Adaptive weights: emphasize core number and betweenness more if bridge_ratio is high,\n    # emphasize clustering if degree variance is low (more homogeneous graphs)\n    w_core = 0.4 * bridge_ratio + 0.3 * (1 - degree_variance)\n    w_betw = 0.4 * (1 - bridge_ratio) + 0.3 * degree_variance\n    w_clust = 1.0 - (w_core + w_betw)\n    if w_clust < 0:\n        w_clust = 0\n        total = w_core + w_betw\n        w_core /= total\n        w_betw /= total\n\n    best_score = -float('inf')\n    next_node = None\n\n    for i, n in enumerate(unvisited_nodes):\n        score = w_core * core_norm[i] + w_betw * betw_norm[i] + w_clust * clust_inv_norm[i]\n        if score > best_score:\n            best_score = score\n            next_node = n\n\n    return next_node",
