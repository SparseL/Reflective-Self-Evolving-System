     {
          "algorithm": "Select the next node to remove by scoring unvisited nodes with a weighted combination of normalized degree, betweenness, inverse clustering, and core number to balance early fragmentation and long-term impact, picking the node with the highest score.",
          "code": "def select_next_node(graph, unvisited_nodes):\n    # Precompute normalization denominators to avoid repeated work\n    degs = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    bcs = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    clusts = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    cores = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n\n    # Avoid divide by zero\n    deg_min, deg_max = min(degs), max(degs)\n    bc_min, bc_max = min(bcs), max(bcs)\n    cl_min, cl_max = min(clusts), max(clusts)\n    core_min, core_max = min(cores), max(cores)\n\n    def normalize(val, vmin, vmax):\n        if vmax - vmin < 1e-8:\n            return 0.0\n        return (val - vmin) / (vmax - vmin)\n\n    best_node = None\n    best_score = -float('inf')\n\n    # Weights tuned to balance early disruption and sustained fragmentation\n    w_deg = 0.4\n    w_bc = 0.35\n    w_inv_clust = 0.15\n    w_core = 0.1\n\n    for n in unvisited_nodes:\n        norm_deg = normalize(graph.nodes[n]['degree'], deg_min, deg_max)\n        norm_bc = normalize(graph.nodes[n]['betweenness'], bc_min, bc_max)\n        norm_clust = normalize(graph.nodes[n]['clustering'], cl_min, cl_max)\n        norm_core = normalize(graph.nodes[n]['core_number'], core_min, core_max)\n\n        score = (w_deg * norm_deg +\n                 w_bc * norm_bc +\n                 w_inv_clust * (1 - norm_clust) +\n                 w_core * norm_core)\n        if score > best_score:\n            best_score = score\n            best_node = n\n\n    return best_node",
