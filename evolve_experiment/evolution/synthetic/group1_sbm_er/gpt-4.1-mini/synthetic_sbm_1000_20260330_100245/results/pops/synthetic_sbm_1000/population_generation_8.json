          "code": "def select_next_node(graph, unvisited_nodes):\n    # Extract global precomputed features\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.5)\n    degree_variance = pre.get('degree_variance', 1.0)\n    \n    # Normalize factors to avoid scale issues\n    max_betw = max((graph.nodes[n]['betweenness'] for n in unvisited_nodes), default=1)\n    max_core = max((graph.nodes[n]['core_number'] for n in unvisited_nodes), default=1)\n    max_degree = max((graph.nodes[n]['degree'] for n in unvisited_nodes), default=1)\n    \n    best_score = -float('inf')\n    next_node = None\n    \n    # Dynamic weighting parameters (weights sum to 1)\n    w_betw = 0.6 * (1 - bridge_ratio) + 0.4 * degree_variance  # Emphasize betweenness more if bridge ratio low or degree variance high\n    w_core = 1 - w_betw\n    \n    for node in unvisited_nodes:\n        betw_norm = graph.nodes[node]['betweenness'] / max_betw if max_betw > 0 else 0\n        core_norm = graph.nodes[node]['core_number'] / max_core if max_core > 0 else 0\n        degree_norm = graph.nodes[node]['degree'] / max_degree if max_degree > 0 else 1\n        \n        # Score combines betweenness and core normalized by degree to avoid picking only hubs\n        score = w_betw * betw_norm + w_core * (core_norm / degree_norm)\n        \n        if score > best_score:\n            best_score = score\n            next_node = node\n    \n    return next_node",
