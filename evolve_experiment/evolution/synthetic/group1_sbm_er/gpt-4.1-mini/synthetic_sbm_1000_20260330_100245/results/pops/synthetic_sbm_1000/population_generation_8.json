          "code": "def select_next_node(graph, unvisited_nodes):\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.5)\n    degree_variance = pre.get('degree_variance', 1.0)\n    max_core_k = pre.get('max_core_k', 1)\n    \n    # Precompute max values for normalization\n    max_betw = max((graph.nodes[n]['betweenness'] for n in unvisited_nodes), default=1)\n    max_degree = max((graph.nodes[n]['degree'] for n in unvisited_nodes), default=1)\n    \n    best_score = -float('inf')\n    next_node = None\n    \n    for n in unvisited_nodes:\n        clust = graph.nodes[n]['clustering']  # Local redundancy\n        betw = graph.nodes[n]['betweenness'] / max_betw if max_betw > 0 else 0  # Global influence\n        \n        core = graph.nodes[n]['core_number']\n        degree = graph.nodes[n]['degree']\n        \n        # Inverse core to promote nodes outside deepest cores\n        inv_core_norm = (max_core_k - core + 1) / max_core_k if max_core_k > 0 else 1\n        degree_norm = degree / max_degree if max_degree > 0 else 0\n        \n        # Composite metric balancing inverse core and degree (harmonic mean to penalize extremes)\n        if inv_core_norm + degree_norm > 0:\n            core_degree_balance = 2 * inv_core_norm * degree_norm / (inv_core_norm + degree_norm)\n        else:\n            core_degree_balance = 0\n        \n        # Final score promotes low clustering (1-clust), moderate betw, and balanced core-degree\n        score = (1 - clust) * 0.5 + betw * 0.3 + core_degree_balance * 0.2\n        \n        if score > best_score:\n            best_score = score\n            next_node = n\n    \n    return next_node",
