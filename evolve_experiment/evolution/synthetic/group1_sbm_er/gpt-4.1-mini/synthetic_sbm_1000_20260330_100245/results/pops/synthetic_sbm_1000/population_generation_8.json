          "code": "def select_next_node(graph, unvisited_nodes):\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.5)\n\n    degs = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    bcs = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    clusts = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n\n    deg_min, deg_max = min(degs), max(degs)\n    bc_min, bc_max = min(bcs), max(bcs)\n    cl_min, cl_max = min(clusts), max(clusts)\n\n    def normalize(val, vmin, vmax):\n        if vmax - vmin < 1e-8:\n            return 0.0\n        return (val - vmin) / (vmax - vmin)\n\n    def harmonic_mean(vals):\n        # Avoid division by zero by adding a small epsilon\n        eps = 1e-8\n        inv_sum = 0.0\n        for v in vals:\n            inv_sum += 1.0 / (v + eps)\n        return len(vals) / inv_sum if inv_sum > 0 else 0.0\n\n    best_node = None\n    best_score = -float('inf')\n\n    for n in unvisited_nodes:\n        norm_deg = normalize(graph.nodes[n]['degree'], deg_min, deg_max)\n        norm_bc = normalize(graph.nodes[n]['betweenness'], bc_min, bc_max)\n        norm_inv_clust = 1 - normalize(graph.nodes[n]['clustering'], cl_min, cl_max)\n\n        # Weighted harmonic mean prioritizing balanced high values\n        h_mean = harmonic_mean([norm_deg, norm_bc, norm_inv_clust])\n\n        # Scale by bridge ratio to emphasize nodes important for global connectivity\n        score = h_mean * bridge_ratio\n\n        if score > best_score:\n            best_score = score\n            best_node = n\n\n    return best_node",
