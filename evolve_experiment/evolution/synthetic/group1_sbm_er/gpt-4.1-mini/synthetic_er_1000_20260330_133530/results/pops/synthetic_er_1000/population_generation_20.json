          "code": "def select_next_node(graph, unvisited_nodes):\n    import math\n\n    eps = 1e-9\n    pre = graph.graph.get('precomputed', {})\n    \n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    clusterings = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    cores = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n    betws = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    eigs = [graph.nodes[n]['eigenvector'] for n in unvisited_nodes]\n\n    def normalize(vals):\n        mn, mx = min(vals), max(vals)\n        if mx - mn < eps:\n            return [0.5] * len(vals)\n        return [(v - mn) / (mx - mn) for v in vals]\n\n    deg_n = normalize(degrees)\n    clust_inv_n = normalize([1 - c for c in clusterings])\n    cores_n = normalize(cores)\n    betws_n = normalize(betws)\n    eigs_n = normalize(eigs)\n\n    best_score = -float('inf')\n    best_node = None\n\n    for i, n in enumerate(unvisited_nodes):\n        a, b, c = deg_n[i] + eps, cores_n[i] + eps, clust_inv_n[i] + eps\n        \n        # Weighted geometric mean with weights emphasizing core number\n        score_geom = (a**0.3) * (b**0.5) * (c**0.2)\n        \n        diff = betws_n[i] - eigs_n[i]\n        # Use tanh scaled by 8 for smooth emphasis on difference\n        mod = (math.tanh(8 * diff) + 1) / 2  \n\n        score = score_geom * mod\n\n        if score > best_score:\n            best_score = score\n            best_node = n\n\n    return best_node",
