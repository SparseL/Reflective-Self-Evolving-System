          "code": "import math\n\ndef select_next_node(graph, unvisited_nodes):\n    eps = 1e-9\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio_high_bc = pre.get('bridge_ratio_high_bc', 1.0)\n    max_core_k = pre.get('max_core_k', 1)\n    \n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    clusterings = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    cores = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n    betws = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    eigs = [graph.nodes[n]['eigenvector'] for n in unvisited_nodes]\n    \n    max_core = max(cores) if cores else max_core_k if max_core_k > 0 else 1\n    \n    def harmonic_mean(a, b):\n        return 2 * a * b / (a + b + eps)\n    \n    best_score = -float('inf')\n    best_node = None\n    \n    for n, deg, clust, core, betw, eig in zip(unvisited_nodes, degrees, clusterings, cores, betws, eigs):\n        core_norm = core / max_core\n        local_penalty = 1 - clust  # prefer low clustering (less redundancy)\n        bridge_factor = (betw + eps) / (eig + eps)\n        \n        # Harmonic mean of normalized core and normalized degree to balance importance\n        score_hm = harmonic_mean(core_norm, deg / (deg + 1))\n        \n        # Boost with bridge factor and penalize high clustering\n        score = score_hm * local_penalty * (1 + bridge_ratio_high_bc * bridge_factor)\n        \n        if score > best_score:\n            best_score = score\n            best_node = n\n            \n    return best_node",
