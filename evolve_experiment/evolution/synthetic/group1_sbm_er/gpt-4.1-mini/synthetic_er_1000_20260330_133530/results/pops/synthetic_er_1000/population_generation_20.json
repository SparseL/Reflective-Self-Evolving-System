          "algorithm": "",
          "code": "import math\nimport networkx as nx\n\ndef select_next_node(graph: nx.Graph, unvisited_nodes):\n    eps = 1e-9\n    pre = graph.graph.get('precomputed', {})\n    avg_deg = pre.get('avg_degree', 1.0)\n    deg_var = pre.get('degree_variance', 1.0)\n    \n    # Precompute normalized features\n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    clusterings = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    betws = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n\n    # Sum of degrees of neighbors (local neighborhood influence)\n    nbr_degree_sum = []\n    for n in unvisited_nodes:\n        nbrs = graph.neighbors(n)\n        s = sum(graph.nodes[v]['degree'] for v in nbrs if v in unvisited_nodes)\n        nbr_degree_sum.append(s)\n\n    def normalize(vals):\n        mn, mx = min(vals), max(vals)\n        if mx - mn < eps:\n            return [0.5] * len(vals)\n        return [(v - mn) / (mx - mn) for v in vals]\n\n    deg_n = normalize(degrees)\n    clust_inv_n = normalize([1 - c for c in clusterings])\n    betw_n = normalize(betws)\n    nbr_deg_sum_n = normalize(nbr_degree_sum)\n\n    # Graph heterogeneity factor (higher variance => emphasize betweenness more)\n    hetero_factor = math.log1p(deg_var + eps)\n\n    best_score = -float('inf')\n    best_node = None\n\n    for i, n in enumerate(unvisited_nodes):\n        # Weighted product of neighbor degree sum and betweenness\n        base = nbr_deg_sum_n[i] * (betw_n[i] + eps)\n        \n        # Modulate by inverse clustering (to prefer less redundant nodes)\n        cluster_factor = clust_inv_n[i]\n        \n        # Adaptive scaling to balance local/global importance\n        score = (base ** (1 / (1 + hetero_factor))) * (cluster_factor ** hetero_factor)\n\n        if score > best_score:\n            best_score = score\n            best_node = n\n\n    return best_node",
