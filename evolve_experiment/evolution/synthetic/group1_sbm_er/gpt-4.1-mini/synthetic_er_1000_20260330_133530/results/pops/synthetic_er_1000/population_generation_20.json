          "code": "import math\n\ndef select_next_node(graph, unvisited_nodes):\n    eps = 1e-9\n    pre = graph.graph.get('precomputed', {})\n    avg_deg = pre.get('avg_degree', 1.0)\n\n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    cores = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n    betws = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    eigs = [graph.nodes[n]['eigenvector'] for n in unvisited_nodes]\n\n    def normalize(vals):\n        mn, mx = min(vals), max(vals)\n        if mx - mn < eps:\n            return [0.5] * len(vals)\n        return [(v - mn) / (mx - mn) for v in vals]\n\n    degrees_n = normalize(degrees)\n    cores_n = normalize(cores)\n    betws_n = normalize(betws)\n    eigs_n = normalize(eigs)\n\n    def geometric_mean(a, b):\n        return (a * b) ** 0.5\n\n    def inv_sigmoid(x):\n        # inverse sigmoid: 1 - sigmoid(x)\n        return 1 / (1 + math.exp(x))\n\n    best_score = -float('inf')\n    best_node = None\n\n    scale_factor = math.log1p(avg_deg)  # smooth scaling based on avg degree\n\n    for i, n in enumerate(unvisited_nodes):\n        gm = geometric_mean(degrees_n[i], cores_n[i])\n        diff = eigs_n[i] - betws_n[i]\n        inv_sig = inv_sigmoid(diff * 10)  # sharpened inverse sigmoid\n\n        score = gm * inv_sig * (1 + scale_factor * diff)\n\n        if score > best_score:\n            best_score = score\n            best_node = n\n\n    return best_node",
