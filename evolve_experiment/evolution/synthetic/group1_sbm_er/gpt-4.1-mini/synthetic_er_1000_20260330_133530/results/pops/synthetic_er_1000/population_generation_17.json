          "code": "import math\n\ndef select_next_node(graph, unvisited_nodes):\n    eps = 1e-9\n\n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    clusts = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    cores = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n    betws = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    eigs = [graph.nodes[n]['eigenvector'] for n in unvisited_nodes]\n\n    pre = graph.graph.get('precomputed', {})\n    avg_deg = pre.get('avg_degree', 1)\n    degree_var = pre.get('degree_variance', 1)\n    max_core_k = pre.get('max_core_k', 1)\n\n    def normalize(vals):\n        mn, mx = min(vals), max(vals)\n        if mx - mn < eps:\n            return [0.5]*len(vals)\n        return [(v - mn) / (mx - mn) for v in vals]\n\n    deg_n = normalize(degrees)\n    clust_inv_n = normalize([1 - c for c in clusts])\n    cores_n = normalize(cores)\n    betws_n = normalize(betws)\n    eigs_n = normalize(eigs)\n\n    best_score = -float('inf')\n    best_node = None\n\n    for i, n in enumerate(unvisited_nodes):\n        # Weighted sum of normalized degree, core number, and inverse clustering\n        base_score = 0.4 * deg_n[i] + 0.4 * cores_n[i] + 0.2 * clust_inv_n[i]\n\n        diff = betws_n[i] - eigs_n[i]\n        # Adaptive exponential weighting to emphasize strong betweenness advantage\n        weight = math.exp(min(max(diff * 8, -5), 5))  # clamp exponent for stability\n\n        score = base_score * weight\n\n        if score > best_score:\n            best_score = score\n            best_node = n\n\n    return best_node",
