          "code": "def select_next_node(graph, unvisited_nodes):\n    eps = 1e-9\n    \n    pre = graph.graph.get('precomputed', {})\n    max_core_k = pre.get('max_core_k', 1)\n    \n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    clusterings = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    cores = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n    betws = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    eigs = [graph.nodes[n]['eigenvector'] for n in unvisited_nodes]\n    \n    max_core = max(cores) if cores else max_core_k if max_core_k > 0 else 1\n    \n    best_score = -float('inf')\n    best_node = None\n    \n    for n, clust, core, betw, eig in zip(unvisited_nodes, clusterings, cores, betws, eigs):\n        # Avoid division by zero in eig\n        eig_adj = eig + eps\n        \n        # Local redundancy inverse (1 - clustering)\n        inv_clust = 1 - clust\n        \n        # Ratio betweenness / eigenvector centrality (bridging over hub)\n        bridge_ratio = betw / eig_adj\n        \n        # Scale core number logarithmically to moderate effect\n        core_factor = (core / max_core) if core > 0 else 0\n        core_scale = core_factor * (1 + (core_factor / (core_factor + 0.5)))\n        \n        # Combined score multiplicatively, emphasizing bridge_ratio and core_scale, attenuated by local clustering\n        score = (inv_clust + eps) * bridge_ratio * core_scale\n        \n        if score > best_score:\n            best_score = score\n            best_node = n\n            \n    return best_node",
