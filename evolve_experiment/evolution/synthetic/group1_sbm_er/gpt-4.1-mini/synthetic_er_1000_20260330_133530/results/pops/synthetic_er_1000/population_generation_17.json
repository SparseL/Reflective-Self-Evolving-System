          "code": "def select_next_node(graph, unvisited_nodes):\n    import math\n\n    eps = 1e-9\n    pre = graph.graph.get('precomputed', {})\n    max_core_k = pre.get('max_core_k', 1)\n\n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    clusterings = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    cores = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n    betws = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    eigs = [graph.nodes[n]['eigenvector'] for n in unvisited_nodes]\n\n    def normalize(vals):\n        mn, mx = min(vals), max(vals)\n        if mx - mn < eps:\n            return [0.5] * len(vals)\n        return [(v - mn) / (mx - mn) for v in vals]\n\n    deg_n = normalize(degrees)\n    clust_inv_n = normalize([1 - c for c in clusterings])\n    cores_n = normalize(cores)\n    betws_n = normalize(betws)\n    eigs_n = normalize(eigs)\n\n    best_score = -float('inf')\n    best_node = None\n\n    for i, n in enumerate(unvisited_nodes):\n        a, b, c = deg_n[i], cores_n[i], clust_inv_n[i]\n        # Harmonic mean of degree, core, inverse clustering\n        denom = (1 / (a + eps)) + (1 / (b + eps)) + (1 / (c + eps))\n        harm_mean = 3 / denom if denom > 0 else 0\n\n        # Sigmoid weight with sharper slope (12) to emphasize bridging vs hubness difference\n        diff = betws_n[i] - eigs_n[i]\n        weight = 1 / (1 + math.exp(-12 * diff))\n\n        score = harm_mean * weight\n\n        if score > best_score:\n            best_score = score\n            best_node = n\n\n    return best_node",
