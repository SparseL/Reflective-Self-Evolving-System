          "code": "import math\n\ndef select_next_node(graph, unvisited_nodes):\n    eps = 1e-9\n\n    # Extract precomputed global features\n    pre = graph.graph.get('precomputed', {})\n    max_core_k = pre.get('max_core_k', 1)\n    avg_deg = pre.get('avg_degree', 1)\n    degree_var = pre.get('degree_variance', 1)\n\n    # Node features\n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    clusts = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    cores = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n    betws = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    eigs = [graph.nodes[n]['eigenvector'] for n in unvisited_nodes]\n\n    def normalize(vals):\n        mn, mx = min(vals), max(vals)\n        if mx - mn < eps:\n            return [0.5] * len(vals)\n        return [(v - mn) / (mx - mn) for v in vals]\n\n    deg_n = normalize(degrees)\n    cores_n = normalize(cores)\n    # Use inverse clustering to promote nodes with weak local redundancy\n    inv_clust_n = normalize([1 - c for c in clusts])\n    betws_n = normalize(betws)\n    eigs_n = normalize(eigs)\n\n    def harmonic_mean(vals):\n        # Harmonic mean: 3 / (sum of reciprocals), add eps for stability\n        return 3.0 / (sum((1/(v+eps) for v in vals)) + eps)\n\n    def sigmoid(x):\n        # Sigmoid to smoothly weight difference [-inf,inf] -> (0,1)\n        return 1 / (1 + math.exp(-x))\n\n    best_score = -float('inf')\n    best_node = None\n\n    for i, n in enumerate(unvisited_nodes):\n        # Harmonic mean of degree, core_number, and inverse clustering\n        base = harmonic_mean([deg_n[i], cores_n[i], inv_clust_n[i]])\n\n        # Weight factor from sigmoid of (betweenness - eigenvector), scaled by 10\n        w = sigmoid((betws_n[i] - eigs_n[i]) * 10)\n\n        score = base * w\n\n        if score > best_score:\n            best_score = score\n            best_node = n\n\n    return best_node",
