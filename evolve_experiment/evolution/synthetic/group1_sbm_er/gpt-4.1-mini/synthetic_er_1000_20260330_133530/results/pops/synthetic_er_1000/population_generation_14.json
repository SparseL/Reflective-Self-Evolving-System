          "code": "import math\n\ndef select_next_node(graph, unvisited_nodes):\n    eps = 1e-9\n    pre = graph.graph.get('precomputed', {})\n    max_core_k = pre.get('max_core_k', 1)\n    \n    degrees = [graph.nodes[n]['degree'] for n in unvisited_nodes]\n    clusterings = [graph.nodes[n]['clustering'] for n in unvisited_nodes]\n    cores = [graph.nodes[n]['core_number'] for n in unvisited_nodes]\n    betws = [graph.nodes[n]['betweenness'] for n in unvisited_nodes]\n    eigs = [graph.nodes[n]['eigenvector'] for n in unvisited_nodes]\n\n    max_deg = max(degrees) if degrees else 1\n    max_core = max(cores) if cores else max_core_k if max_core_k > 0 else 1\n    max_betw = max(betws) if betws else 1\n    max_eig = max(eigs) if eigs else eps\n\n    # Normalize helper\n    def normalize(vals):\n        mn, mx = min(vals), max(vals)\n        if mx - mn < eps:\n            return [0.5]*len(vals)\n        return [(v - mn) / (mx - mn) for v in vals]\n\n    deg_n = normalize(degrees)\n    clust_n = normalize(clusterings)\n    cores_n = normalize(cores)\n    betws_n = normalize(betws)\n    eigs_n = normalize(eigs)\n\n    def entropy3(p, q, r):\n        # Entropy-like measure of structural diversity of node features\n        vals = [max(p, eps), max(q, eps), max(r, eps)]\n        s = sum(vals)\n        ps = [v/s for v in vals]\n        return -sum(p_i * math.log(p_i) for p_i in ps)\n\n    best_score = -float('inf')\n    best_node = None\n\n    for i, n in enumerate(unvisited_nodes):\n        # Structural entropy from normalized degree, 1-clustering (diversity of local connectivity), and core number\n        inv_clust = 1 - clust_n[i]\n        struct_entropy = entropy3(deg_n[i], inv_clust, cores_n[i])\n\n        # Bridging factor: betweenness adjusted inversely by eigenvector centrality to penalize hubs\n        bridge_factor = betws_n[i] / (eigs_n[i] + eps)\n\n        # Combined score: product to emphasize nodes that are both structurally diverse and key bridges\n        score = struct_entropy * bridge_factor\n\n        if score > best_score:\n            best_score = score\n            best_node = n\n\n    return best_node",
