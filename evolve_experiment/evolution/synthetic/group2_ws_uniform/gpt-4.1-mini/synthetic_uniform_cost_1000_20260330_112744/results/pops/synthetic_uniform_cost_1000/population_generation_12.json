          "code": "def select_next_node(graph, unvisited_nodes):\n    import numpy as np\n\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.1)\n\n    unvisited_set = set(unvisited_nodes)\n\n    degrees = np.array([graph.nodes[n]['degree'] for n in unvisited_nodes], dtype=float)\n    clusterings = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n\n    # Normalize degree and clustering\n    def normalize(arr):\n        minv, maxv = arr.min(), arr.max()\n        if maxv - minv < 1e-9:\n            return np.ones_like(arr)\n        return (arr - minv) / (maxv - minv)\n\n    norm_deg = normalize(degrees)\n    norm_clust = normalize(clusterings)\n\n    # Residual degree = degree normalized, but consider only unvisited neighbors\n    residual_deg = []\n    for n in unvisited_nodes:\n        nbrs = set(graph.neighbors(n))\n        unvisited_nbrs = nbrs & unvisited_set\n        residual_deg.append(len(unvisited_nbrs))\n    residual_deg = np.array(residual_deg, dtype=float)\n    norm_res_deg = normalize(residual_deg)\n\n    # Local vulnerability score balances residual degree and inverse clustering\n    # Dynamic weight to bridge ratio to adjust aggressiveness\n    w_res_deg = 0.6 + 0.3 * bridge_ratio\n    w_inv_clust = 0.4 - 0.3 * bridge_ratio\n\n    scores = w_res_deg * norm_res_deg + w_inv_clust * (1 - norm_clust)\n\n    idx = np.argmax(scores)\n    return unvisited_nodes[idx]",
