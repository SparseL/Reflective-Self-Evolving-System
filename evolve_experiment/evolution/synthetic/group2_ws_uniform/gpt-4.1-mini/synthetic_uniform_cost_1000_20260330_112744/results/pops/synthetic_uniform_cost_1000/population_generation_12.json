          "code": "def select_next_node(graph, unvisited_nodes):\n    import numpy as np\n\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.1)\n\n    unvisited_set = set(unvisited_nodes)\n\n    residual_deg = []\n    core_numbers = []\n    nbr_avg_betw = []\n\n    for n in unvisited_nodes:\n        nbrs = set(graph.neighbors(n))\n        unv_nbrs = nbrs & unvisited_set\n        residual_deg.append(len(unv_nbrs))\n        core_numbers.append(graph.nodes[n].get('core_number', 0))\n        # average betweenness of neighbors (or 0 if no neighbors)\n        if unv_nbrs:\n            avg_betw = np.mean([graph.nodes[nb].get('betweenness', 0) for nb in unv_nbrs])\n        else:\n            avg_betw = 0\n        nbr_avg_betw.append(avg_betw)\n\n    residual_deg = np.array(residual_deg, dtype=float)\n    core_numbers = np.array(core_numbers, dtype=float)\n    nbr_avg_betw = np.array(nbr_avg_betw, dtype=float)\n\n    def normalize(arr):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-9:\n            return np.ones_like(arr)\n        return (arr - mn) / (mx - mn)\n\n    norm_res_deg = normalize(residual_deg)\n    norm_core = normalize(core_numbers)\n    norm_nbr_betw = normalize(nbr_avg_betw)\n\n    # Dynamic weighting: give more weight to residual degree and core for low bridge_ratio,\n    # and emphasize neighbor betweenness penalty when bridge_ratio is high\n    w_res_core = 0.7 - 0.4 * bridge_ratio\n    w_nbr_betw_pen = 0.3 + 0.4 * bridge_ratio\n\n    combined_score = (norm_res_deg * norm_core) * w_res_core - norm_nbr_betw * w_nbr_betw_pen\n\n    idx = np.argmax(combined_score)\n    return unvisited_nodes[idx]",
