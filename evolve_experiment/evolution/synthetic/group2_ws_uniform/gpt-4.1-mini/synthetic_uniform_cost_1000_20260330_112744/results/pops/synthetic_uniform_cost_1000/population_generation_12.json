          "code": "def select_next_node(graph, unvisited_nodes):\n    import numpy as np\n\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.1)\n\n    unvisited_set = set(unvisited_nodes)\n\n    eig = np.array([graph.nodes[n]['eigenvector'] for n in unvisited_nodes], dtype=float)\n    clus = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n\n    # Compute disruption potential as product of core_numbers of unvisited neighbors\n    disruption_potentials = []\n    for n in unvisited_nodes:\n        nbrs = set(graph.neighbors(n))\n        unv_nbrs = nbrs & unvisited_set\n        if not unv_nbrs:\n            disruption_potentials.append(0.0)\n        else:\n            core_vals = [graph.nodes[nb]['core_number'] for nb in unv_nbrs]\n            disruption_potentials.append(np.prod(core_vals))\n    disruption_potentials = np.array(disruption_potentials, dtype=float)\n\n    def normalize(arr):\n        minv, maxv = arr.min(), arr.max()\n        if maxv - minv < 1e-9:\n            return np.ones_like(arr)\n        return (arr - minv) / (maxv - minv)\n\n    norm_eig = normalize(eig)\n    inv_clus = 1 - normalize(clus)\n    norm_dp = normalize(disruption_potentials)\n\n    # Dynamic weighting to balance eigenvector and disruption potential by bridge ratio\n    w_eig = 0.6 - 0.4 * bridge_ratio\n    w_dp = 0.4 + 0.4 * bridge_ratio\n\n    scores = (w_eig * norm_eig + w_dp * norm_dp) * inv_clus\n\n    idx = np.argmax(scores)\n    return unvisited_nodes[idx]",
