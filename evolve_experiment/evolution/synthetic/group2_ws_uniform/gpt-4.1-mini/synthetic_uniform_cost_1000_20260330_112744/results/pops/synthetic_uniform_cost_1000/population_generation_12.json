          "code": "import numpy as np\n\ndef select_next_node(graph, unvisited_nodes):\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.1)\n    degree_variance = pre.get('degree_variance', 1)\n    max_core_k = pre.get('max_core_k', 1)\n\n    unvisited_set = set(unvisited_nodes)\n\n    betweenness = np.array([graph.nodes[n]['betweenness'] for n in unvisited_nodes], dtype=float)\n    clustering = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n    core_number = np.array([graph.nodes[n]['core_number'] for n in unvisited_nodes], dtype=float)\n\n    def normalize(arr):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-9:\n            return np.ones_like(arr)\n        return (arr - mn) / (mx - mn)\n\n    norm_bc = normalize(betweenness)\n    inv_clust = 1 - clustering\n    norm_core = normalize(core_number)\n\n    # Approximate second-order reachability: number of unvisited neighbors + avg unvisited neighbors of neighbors\n    second_order_reach = []\n    for node in unvisited_nodes:\n        nbrs = set(nbr for nbr in graph.neighbors(node) if nbr in unvisited_set)\n        if not nbrs:\n            second_order_reach.append(0)\n            continue\n        nbrs_2_count = 0\n        for nbr in nbrs:\n            nbrs_2_count += len(set(graph.neighbors(nbr)) & unvisited_set)\n        avg_nbrs_2 = nbrs_2_count / len(nbrs)\n        second_order_reach.append(len(nbrs) + 0.5 * avg_nbrs_2)  # weighted sum\n    second_order_reach = np.array(second_order_reach, dtype=float)\n    norm_reach = normalize(second_order_reach)\n\n    # Adaptive weights balancing early disruption and thorough fragmentation\n    w_reach = 0.45 + 0.3 * bridge_ratio\n    w_bc = 0.4 - 0.25 * (degree_variance / (degree_variance + 10))\n    w_inv_clust = 0.15 + 0.1 * (max_core_k / (max_core_k + 5))\n\n    # Normalize weights\n    w_sum = w_reach + w_bc + w_inv_clust\n    w_reach /= w_sum\n    w_bc /= w_sum\n    w_inv_clust /= w_sum\n\n    # Incorporate core number multiplicatively to emphasize node position robustness\n    scores = (w_reach * norm_reach + w_bc * norm_bc + w_inv_clust * inv_clust) * (norm_core + 1e-9)\n\n    idx = np.argmax(scores)\n    return unvisited_nodes[idx]",
