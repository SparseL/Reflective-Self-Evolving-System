          "code": "import numpy as np\n\ndef select_next_node(graph, unvisited_nodes):\n    pre = graph.graph.get('precomputed', {})\n    degree_variance = pre.get('degree_variance', 1)\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.5)\n    \n    betweennesses = np.array([graph.nodes[n]['betweenness'] for n in unvisited_nodes], dtype=float)\n    eigenvectors = np.array([graph.nodes[n]['eigenvector'] for n in unvisited_nodes], dtype=float)\n    clusterings = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n    degrees = np.array([graph.nodes[n]['degree'] for n in unvisited_nodes], dtype=float)\n    \n    def normalize(arr):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-8:\n            return np.ones_like(arr) * 0.5\n        return (arr - mn) / (mx - mn)\n    \n    betw_norm = normalize(np.log1p(betweennesses))\n    eig_norm = normalize(eigenvectors)\n    clust_norm = normalize(clusterings)\n    deg_norm = normalize(degrees)\n    \n    # Bridging potential: eigenvector centrality scaled inversely by clustering (avoid div by zero)\n    eps = 1e-6\n    bridge_potential = eig_norm / (clust_norm + eps)\n    \n    # Composite score: weighted betweenness by bridge potential\n    base_score = betw_norm * bridge_potential\n    \n    # Dynamic penalty scaled by bridge_ratio and degree variance to avoid selecting overly clustered hubs\n    penalty = (clust_norm * (bridge_ratio * np.tanh(degree_variance - 1)))\n    \n    final_score = base_score - penalty + 0.1 * deg_norm  # small tie-break by degree\n    \n    idx = np.argmax(final_score)\n    next_node = unvisited_nodes[idx]\n    return next_node",
