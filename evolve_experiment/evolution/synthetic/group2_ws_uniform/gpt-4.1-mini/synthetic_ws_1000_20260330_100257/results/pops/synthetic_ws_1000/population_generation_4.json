          "algorithm": "Select the next node by scoring unvisited nodes through a weighted combination of normalized eigenvector centrality and core number, subtracting a penalty proportional to clustering coefficient scaled by the ratio of diameter to average path length in the largest connected component, to balance influence in core structures and network spread.",
          "code": "import numpy as np\n\ndef select_next_node(graph, unvisited_nodes):\n    pre = graph.graph['precomputed']\n    diameter = pre.get('diameter_lcc', 1)\n    apl = pre.get('apl_lcc', 1)\n\n    eigenvector = np.array([graph.nodes[n]['eigenvector'] for n in unvisited_nodes], dtype=float)\n    core_number = np.array([graph.nodes[n]['core_number'] for n in unvisited_nodes], dtype=float)\n    clustering = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n\n    def normalize(arr):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-8:\n            return np.ones_like(arr) * 0.5\n        return (arr - mn) / (mx - mn)\n\n    eig_norm = normalize(eigenvector)\n    core_norm = normalize(core_number)\n    clust_norm = normalize(clustering)\n\n    penalty_scale = diameter / (apl + 1e-6)\n    score = 0.6 * eig_norm + 0.4 * core_norm - penalty_scale * clust_norm\n\n    idx = np.argmax(score)\n    next_node = unvisited_nodes[idx]\n    return next_node",
