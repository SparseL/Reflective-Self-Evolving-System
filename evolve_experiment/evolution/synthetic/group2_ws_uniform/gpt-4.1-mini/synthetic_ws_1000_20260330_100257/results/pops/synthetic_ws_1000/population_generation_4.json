          "code": "import numpy as np\n\ndef select_next_node(graph, unvisited_nodes):\n    pre = graph.graph['precomputed']\n    diameter = pre.get('diameter_lcc', 1)\n    apl = pre.get('apl_lcc', 1)\n\n    core_nums = np.array([graph.nodes[n]['core_number'] for n in unvisited_nodes], dtype=float)\n    eigens = np.array([graph.nodes[n]['eigenvector'] for n in unvisited_nodes], dtype=float)\n    clust = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n\n    def normalize(arr):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-8:\n            return np.ones_like(arr) * 0.5\n        return (arr - mn) / (mx - mn)\n\n    core_norm = normalize(core_nums)\n    eig_norm = normalize(eigens)\n    clust_norm = normalize(clust)\n\n    influence = core_norm * eig_norm\n    penalty = (clust_norm * (diameter / (apl + 1e-6)))\n\n    novelty_scores = influence - penalty\n\n    idx = np.argmax(novelty_scores)\n    next_node = unvisited_nodes[idx]\n    return next_node",
