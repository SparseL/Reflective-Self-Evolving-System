          "code": "import numpy as np\n\ndef select_next_node(graph, unvisited_nodes):\n    pre = graph.graph.get('precomputed', {})\n    avg_degree = pre.get('avg_degree', 1)\n    max_core = pre.get('max_core_k', 1)\n\n    degrees = np.array([graph.nodes[n]['degree'] for n in unvisited_nodes], dtype=float)\n    cores = np.array([graph.nodes[n]['core_number'] for n in unvisited_nodes], dtype=float)\n    clusts = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n    eigs = np.array([graph.nodes[n]['eigenvector'] for n in unvisited_nodes], dtype=float)\n\n    def normalize(arr, floor=0.5):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-8:\n            return np.ones_like(arr) * floor\n        return (arr - mn) / (mx - mn)\n\n    deg_norm = normalize(degrees)\n    core_norm = normalize(cores)\n    clust_norm = normalize(clusts)\n    eig_norm = normalize(eigs)\n\n    # Local fragmentation potential = (degree * core) - clustering\n    frag_score = (deg_norm * core_norm) - clust_norm\n\n    # Prefer nodes with high frag_score; if tie, select node with smaller eigenvector centrality\n    max_frag = np.max(frag_score)\n    candidates = np.where(frag_score == max_frag)[0]\n\n    if len(candidates) == 1:\n        idx = candidates[0]\n    else:\n        # among candidates, pick one with minimum eigenvector centrality\n        eig_candidates = eig_norm[candidates]\n        idx = candidates[np.argmin(eig_candidates)]\n\n    next_node = unvisited_nodes[idx]\n    return next_node",
