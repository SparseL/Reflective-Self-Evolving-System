          "algorithm": "",
          "code": "import numpy as np\n\ndef select_next_node(graph, unvisited_nodes):\n    pre = graph.graph.get('precomputed', {})\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 0.5)\n    avg_degree = pre.get('avg_degree', 1)\n    degree_variance = pre.get('degree_variance', 1)\n    max_core_k = pre.get('max_core_k', 1)\n\n    eig = np.array([graph.nodes[n]['eigenvector'] for n in unvisited_nodes], dtype=float)\n    betw = np.array([graph.nodes[n]['betweenness'] for n in unvisited_nodes], dtype=float)\n    core = np.array([graph.nodes[n]['core_number'] for n in unvisited_nodes], dtype=float)\n    clust = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n    deg = np.array([graph.nodes[n]['degree'] for n in unvisited_nodes], dtype=float)\n\n    def normalize(arr):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-8:\n            return np.ones_like(arr) * 0.5\n        return (arr - mn) / (mx - mn)\n    \n    eig_norm = normalize(eig)\n    betw_norm = normalize(np.log1p(betw))\n    core_norm = normalize(core)\n    clust_norm = normalize(clust)\n    deg_norm = normalize(deg)\n\n    # Adaptive weighting of core number by degree variance scaled to max_core_k \n    core_weight = min(1.0, degree_variance / (max_core_k + 1e-6))\n\n    # Combine eigenvector and betweenness emphasizing influence spread\n    centrality_score = 0.6 * eig_norm + 0.4 * betw_norm\n\n    # Penalize clustering scaled by degree variance to reduce tightly clustered nodes\n    clustering_penalty = clust_norm * (0.5 + 0.5 * np.tanh(degree_variance - 1))\n\n    # Degree factor to moderate score scaling, avoid hubs bias\n    deg_factor = deg / (avg_degree + 1e-6)\n\n    # Final score balances centrality, core number, clustering penalty, weighted by bridge_ratio\n    score = (bridge_ratio * centrality_score + (1 - bridge_ratio) * core_weight * core_norm) * deg_factor - clustering_penalty\n\n    idx = np.argmax(score)\n    next_node = unvisited_nodes[idx]\n    return next_node",
