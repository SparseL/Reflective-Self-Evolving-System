          "code": "import numpy as np\n\ndef select_next_node(graph, unvisited_nodes):\n    pre = graph.graph['precomputed']\n    avg_deg = pre.get('avg_degree', 1)\n    deg_var = pre.get('degree_variance', 1)\n\n    betweenness = np.array([graph.nodes[n]['betweenness'] for n in unvisited_nodes], dtype=float)\n    degree = np.array([graph.nodes[n]['degree'] for n in unvisited_nodes], dtype=float)\n    clustering = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n\n    def normalize(arr):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-8:\n            return np.ones_like(arr) * 0.5\n        return (arr - mn) / (mx - mn)\n\n    betw_norm = normalize(betweenness)\n    deg_norm = normalize(degree)\n    clust_norm = normalize(clustering)\n\n    penalty_scale = avg_deg / (deg_var + 1e-6)\n    score = 0.7 * betw_norm + 0.3 * deg_norm - penalty_scale * clust_norm\n\n    idx = np.argmax(score)\n    next_node = unvisited_nodes[idx]\n    return next_node",
