          "code": "import numpy as np\n\ndef select_next_node(graph, unvisited_nodes):\n    pre = graph.graph.get('precomputed', {})\n    degree_variance = pre.get('degree_variance', 1)\n\n    betw = np.array([graph.nodes[n]['betweenness'] for n in unvisited_nodes], dtype=float)\n    clust = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n    degs = np.array([graph.nodes[n]['degree'] for n in unvisited_nodes], dtype=float)\n\n    def normalize(arr):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-8:\n            return np.ones_like(arr) * 0.5\n        return (arr - mn) / (mx - mn)\n\n    betw_norm = normalize(np.log1p(betw))  # log scale to reduce skew\n    clust_norm = normalize(clust)\n    deg_norm = normalize(degs)\n\n    # Avoid division by zero by adding epsilon, penalize high clustering in denominator\n    eps = 1e-6\n    score = betw_norm / (clust_norm + eps)\n\n    # Dynamic scaling by degree variance to prioritize bottlenecks in heterogeneous graphs\n    scale = 1 + np.tanh((degree_variance - 2) / 2)\n    score *= scale\n\n    # Tie-break by degree to favor influential nodes\n    final_scores = score + 0.1 * deg_norm\n\n    idx = np.argmax(final_scores)\n    next_node = unvisited_nodes[idx]\n    return next_node",
