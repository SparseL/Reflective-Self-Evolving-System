          "code": "import numpy as np\n\ndef select_next_node(graph, unvisited_nodes):\n    pre = graph.graph['precomputed']\n    bridge_ratio = pre.get('bridge_ratio_high_bc', 1e-3)\n    max_core = pre.get('max_core_k', 1)\n    \n    degrees = np.array([graph.nodes[n]['degree'] for n in unvisited_nodes], dtype=float)\n    betweenness = np.array([graph.nodes[n]['betweenness'] for n in unvisited_nodes], dtype=float)\n    clustering = np.array([graph.nodes[n]['clustering'] for n in unvisited_nodes], dtype=float)\n    core_nums = np.array([graph.nodes[n]['core_number'] for n in unvisited_nodes], dtype=float)\n    \n    def normalize(arr):\n        mn, mx = arr.min(), arr.max()\n        if mx - mn < 1e-8:\n            return np.ones_like(arr) * 0.5\n        return (arr - mn) / (mx - mn)\n    \n    deg_norm = normalize(degrees)\n    bc_norm = normalize(betweenness)\n    clust_norm = normalize(clustering)\n    core_norm = core_nums / max_core if max_core > 0 else np.ones_like(core_nums)\n    \n    score = (0.6 * bc_norm + 0.3 * deg_norm) - (clust_norm / (bridge_ratio + 1e-6))\n    score = score * (1 + core_norm)\n    \n    idx = np.argmax(score)\n    next_node = unvisited_nodes[idx]\n    return next_node",
